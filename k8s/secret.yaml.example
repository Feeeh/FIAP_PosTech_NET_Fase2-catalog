apiVersion: v1
kind: Secret
metadata:
  name: catalog-api-secret
  namespace: fcg
  labels:
    app: catalog-api
    app.kubernetes.io/part-of: fcg
type: Opaque
stringData:
  ConnectionStrings__SqlServer: "Server=sqlserver,1433;Database=fcg_catalog;User Id=sa;Password=TROCAR_SENHA_SQLSERVER;TrustServerCertificate=True;Encrypt=False"
  RabbitMq__Usuario: TROCAR_USUARIO_RABBITMQ
  RabbitMq__Senha: TROCAR_SENHA_RABBITMQ
  Jwt__ChaveSecreta: TROCAR_CHAVE_DE_PELO_MENOS_32_BYTES
